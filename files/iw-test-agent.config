config agent 'main'
	option enabled '0'
	# laptop (controller) IP reachable over the ethernet management link
	option server '192.168.1.100'
	option port '5555'
	# defaults to the hostname when empty
	option name ''
	option token ''
	# only needed when "iwinfo nl80211 phyname radioX" does not resolve, e.g. 'phy0=radio0,phy1=radio1,phy2=radio2'
	option radio_map ''
	# vendor hook for 5/10 MHz, %p=phy %r=radio %b=bandwidth %c=channel
	option narrowband_cmd ''
